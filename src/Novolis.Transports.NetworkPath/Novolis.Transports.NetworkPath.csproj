<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.Transports.NetworkPath</PackageId>
    <IsPackable>true</IsPackable>
    <RootNamespace>Novolis.Transports.NetworkPath</RootNamespace>
    <Description>Cross-platform network adapter, route, and bound-path probing.</Description>
    <PackageTags>network;path;adapter;route;vpn;probe;transports;novolis</PackageTags>
    <PackageProjectUrl>https://github.com/Novolis-Platform/novolis-transports</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Novolis-Platform/novolis-transports</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
</Project>
