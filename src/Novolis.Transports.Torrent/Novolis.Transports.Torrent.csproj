<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.Transports.Torrent</PackageId>
    <IsPackable>true</IsPackable>
    <RootNamespace>Novolis.Transports.Torrent</RootNamespace>
    <Description>
      BitTorrent Protocol 1.0 peer client: BEncode, .torrent metadata, HTTP/UDP trackers, peer wire, piece persistence.
      Ported from Frank.TorrentClient (MIT; original Aljaz Simonic / Frank R. Haugen).
    </Description>
    <PackageTags>bittorrent;torrent;p2p;bencode;transports;novolis</PackageTags>
    <PackageProjectUrl>https://github.com/Novolis-Platform/novolis-transports</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Novolis-Platform/novolis-transports</RepositoryUrl>
    <!-- ProjectRef consumers need DefensiveProgrammingFramework beside this assembly. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!--
      Legacy port baseline: nullable contracts and public documentation are not yet
      annotated consistently. Keep the remaining warning IDs explicit and local to
      this project; malformed XML cref diagnostics are fixed in the source.
    -->
    <NoWarn>$(NoWarn);CS1591;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8622;CS8625;CS8765;CS8767</NoWarn>
  </PropertyGroup>
  <!-- No third-party deps: legacy DefensiveProgrammingFramework replaced by Internal/DefensiveCompat.cs -->
</Project>
